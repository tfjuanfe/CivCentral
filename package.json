{
  "name": "civcentral",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "resend": "4.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "prisma": "5.22.0",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
