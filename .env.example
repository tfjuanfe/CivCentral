# Copy this file to ".env" and fill in real values.
#
# With the Vercel + Neon Postgres integration these are created automatically;
# locally you can fetch them with: vercel env pull .env
#
#   POSTGRES_PRISMA_URL      = pooled, Prisma-ready connection (runtime)
#   POSTGRES_URL_NON_POOLING = direct connection (migrations / prisma db push)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Secret used to sign session cookies. Use a long random value in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Email verification (Resend) ----
# API key from https://resend.com/api-keys. In development, an unset key logs
# the verification link to the server console. It is required in production.
RESEND_API_KEY=""
# The verified "From" address. Until you verify a sending domain in Resend you
# can use their shared onboarding sender below.
EMAIL_FROM="CivCentral <onboarding@resend.dev>"
# Absolute base URL used to build links inside emails. Optional locally and
# required in production, e.g. https://civcentral.com
NEXT_PUBLIC_APP_URL=""

# ---- Media storage (Cloudflare R2, S3-compatible) ----
# From the Cloudflare dashboard: R2 > Manage R2 API Tokens (account ID is shown
# on the R2 overview). If these are unset, the upload route returns 503 and the
# rest of the app works unchanged.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# HTTPS public base URL objects are served from. Required when uploads are
# enabled; use an R2 public bucket URL or custom domain, e.g.
# https://media.civcentral.com
R2_PUBLIC_BASE_URL=""

# ---- Discord sign-in (OAuth2) ----
# Create an app at https://discord.com/developers/applications, then under
# OAuth2 copy the Client ID and Client Secret. Under OAuth2 → Redirects, add:
#   http://localhost:3000/api/auth/discord/callback        (local dev)
#   https://YOUR-DOMAIN/api/auth/discord/callback          (production)
# The "Continue with Discord" button only appears when both values are set.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Optional: pin the exact redirect URI. If unset it's derived from the request
# host (or NEXT_PUBLIC_APP_URL). It MUST match a redirect registered above.
DISCORD_REDIRECT_URI=""
