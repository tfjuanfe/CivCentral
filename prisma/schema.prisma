// WikiCiv data model.
//
// Production runs on PostgreSQL (Neon, via Vercel). Set DATABASE_URL to the
// pooled connection string and DIRECT_URL to the direct (non-pooled) one.
// Entry.infobox is stored as a JSON string for portability; it can be switched
// to the native Json type later if desired.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled, Prisma-ready connection (pgbouncer) — used at runtime. Auto-created
  // by the Vercel/Neon Postgres integration.
  url       = env("POSTGRES_PRISMA_URL")
  // Direct (non-pooled) connection — used by `prisma db push` / migrations.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // Optional: accounts can exist without an email, but a verified email is
  // required to contribute. Stored lowercased; unique among set values
  // (Postgres treats multiple NULLs as distinct, so absence is always allowed).
  email         String? @unique
  emailVerified Boolean @default(false)
  // Optional: Discord-authenticated accounts have no password.
  passwordHash String?
  // Set for accounts created via "Continue with Discord"; links the Discord user.
  discordId    String?  @unique
  role         String   @default("contributor") // reader | contributor | archivist
  trusted      Boolean  @default(false)
  bio          String   @default("")
  createdAt    DateTime @default(now())

  // Timestamp of the user's agreement to the Terms of Use + Privacy Policy.
  // Null for accounts created before consent was collected.
  termsAcceptedAt DateTime?

  // Moderation. `bannedAt` set = currently banned. `bannedUntil` null while
  // banned means the ban is permanent; a past `bannedUntil` means it lapsed
  // (checked at read time, so no cron job is needed to expire it).
  bannedAt     DateTime?
  bannedUntil  DateTime?
  banReason    String?
  bannedByName String?

  entries            Entry[]                  @relation("EntryAuthor")
  revisions          Revision[]               @relation("RevisionEditor")
  stars              Star[]
  comments           Comment[]
  verificationTokens EmailVerificationToken[]
  eventRatings       EventRating[]
  commentVotes       CommentVote[]
  hostedEvents       Event[]                  @relation("EventHost")
}

// Single-use email-verification tokens. Only a SHA-256 hash of the token is
// stored; the raw token travels in the emailed link. Expired/used tokens are
// deleted. A user has at most one outstanding token (older ones are cleared on
// resend).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String // the address this token verifies (may differ from User.email if changed)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  events      Event[]
}

model Event {
  id          String    @id @default(cuid())
  serverId    String
  name        String
  theme       String    @default("")
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ongoing") // upcoming | ongoing | concluded
  description String    @default("")
  discordUrl  String    @default("")

  // The member who runs this event. Set to the creator; null for events that
  // predate hosting (those stay archivist-managed only).
  hostId String?

  // ---- Host-controlled page settings ----
  // Whether the rating widget is offered on this event's page at all.
  ratingsEnabled Boolean @default(true)
  // Whether the aggregate score is shown to everyone. When false, raters still
  // see their own rating but the average/count is host + archivist only.
  ratingsPublic Boolean @default(true)
  // Whether a verified email is required to rate or comment HERE. Hosts may
  // relax it for their own page; contributing entries always requires one.
  requireVerifiedEmail Boolean @default(true)
  // Whether the discussion thread accepts new comments.
  commentsEnabled Boolean @default(true)

  server  Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  host    User?         @relation("EventHost", fields: [hostId], references: [id], onDelete: SetNull)
  entries Entry[]
  ratings EventRating[]

  @@index([serverId])
  @@index([hostId])
}

model Entry {
  id           String   @id @default(cuid())
  eventId      String
  type         String // civilization | character | war | place | artifact
  layer        String // record | account
  name         String
  infobox      String   @default("{}") // JSON string of structured fields
  body         String   @default("") // markdown
  authorId     String
  attributedTo String? // faction/player a RP account is told by (account layer)
  status       String   @default("pending") // draft | pending | published
  disputed     Boolean  @default(false)
  // Feedback left by an archivist when sending an entry back for changes.
  // Surfaced to the author on their "My Contributions" page; cleared on resubmit.
  reviewFeedback   String?
  reviewFeedbackAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author    User       @relation("EntryAuthor", fields: [authorId], references: [id])
  evidence  Evidence[]
  revisions Revision[]

  @@index([eventId])
  @@index([status])
  @@index([type])
  @@index([layer])
}

model Evidence {
  id      String  @id @default(cuid())
  entryId String
  url     String
  caption String?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model Revision {
  id        String   @id @default(cuid())
  entryId   String
  body      String
  infobox   String
  note      String   @default("") // e.g. "created", "edited", "rolled back to <date>"
  editorId  String
  createdAt DateTime @default(now())

  entry  Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  editor User  @relation("RevisionEditor", fields: [editorId], references: [id])

  @@index([entryId])
}

// Durable record of moderation/review actions. Intentionally has NO foreign-key
// relations and stores denormalized snapshots (names), so the log survives even
// after the target entry/event/server or a user is deleted.
// Stars and comments attach to a SUBJECT (eventId + type + name), not a single
// entry, because a subject page is reachable through any of its entries' IDs.
// subjectKey is the same grouping key used throughout the app.
model Star {
  id         String   @id @default(cuid())
  subjectKey String
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectKey, userId])
  @@index([subjectKey])
}

model Comment {
  id         String   @id @default(cuid())
  subjectKey String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommentVote[]

  @@index([subjectKey])
  @@index([createdAt])
}

// One up/downvote per user per comment. Re-casting the same direction clears
// the vote; casting the opposite flips it. The score is derived by summing
// `value`, so there is no denormalized counter to drift.
model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  value     Int // 1 (up) | -1 (down)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

// A user-filed report about a comment or an entry, reviewed by archivists.
// Like AuditLog this has NO foreign-key relations and stores denormalized
// snapshots, so a report (and the evidence in it) survives the reported
// content being deleted — which is exactly what happens when it's actioned.
model Report {
  id         String @id @default(cuid())
  targetType String // comment | entry
  targetId   String
  // Snapshot of what was reported, captured at filing time.
  targetExcerpt    String  @default("")
  targetAuthorId   String?
  targetAuthorName String  @default("")
  // Where a reviewer can go to see it in context.
  contextUrl String @default("")

  reason   String // see REPORT_REASONS in src/lib/reports.ts
  details  String @default("")

  reporterId   String
  reporterName String

  status        String    @default("open") // open | resolved | dismissed
  resolution    String? // note the archivist left when closing it
  handledByName String?
  handledAt     DateTime?

  createdAt DateTime @default(now())

  // One open report per person per target; re-reporting updates their own.
  @@unique([targetType, targetId, reporterId])
  @@index([status])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// A member's rating of a (concluded/ongoing) event, on a 1–5 Minecraft-tier
// scale (copper → netherite). One rating per user per event; updating re-rates.
model EventRating {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  value     Int // 1..5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// Fixed-window rate-limit counters, keyed by action + IP (or user). Stored in
// the DB so limits are shared across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // see AuditAction in src/lib/audit.ts
  actorId    String // who performed the action (archivist)
  actorName  String
  targetType String // entry | event | server | comment | user
  targetId   String?
  targetName String
  authorName String? // original submitter (for entries)
  reason     String? // e.g. the change-request message
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
