// CivCentral data model.
//
// Production runs on PostgreSQL (Neon, via Vercel). Set DATABASE_URL to the
// pooled connection string and DIRECT_URL to the direct (non-pooled) one.
// Entry.infobox is stored as a JSON string for portability; it can be switched
// to the native Json type later if desired.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled, Prisma-ready connection (pgbouncer) — used at runtime. Auto-created
  // by the Vercel/Neon Postgres integration.
  url       = env("POSTGRES_PRISMA_URL")
  // Direct (non-pooled) connection — used by `prisma db push` / migrations.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // Optional: accounts can exist without an email, but a verified email is
  // required to contribute. Stored lowercased; unique among set values
  // (Postgres treats multiple NULLs as distinct, so absence is always allowed).
  email         String? @unique
  emailVerified Boolean @default(false)
  // Optional: an account created through Discord sign-in has no password until
  // its owner sets one. Every code path that compares a password must treat
  // null as "this account has no password login" rather than passing it to
  // bcrypt.
  passwordHash String?
  role         String   @default("contributor") // reader | contributor | archivist
  trusted      Boolean  @default(false)
  // Event hosts may submit servers/events for archivist review. Composable with
  // any role, so a contributor can also be an event host.
  eventHost    Boolean  @default(false)
  bio          String   @default("")
  // Discord identity (F1) — links a Discord account for login + bot features.
  discordId       String? @unique
  discordUsername String?
  discordAvatar   String?
  // Uploaded profile picture (F2); falls back to a Discord avatar or a monogram.
  avatarUrl       String?
  // Moderation status (F4): active | suspended | banned.
  status         String    @default("active")
  suspendedUntil DateTime?
  createdAt    DateTime @default(now())

  entries            Entry[]                  @relation("EntryAuthor")
  revisions          Revision[]               @relation("RevisionEditor")
  stars              Star[]
  comments           Comment[]
  verificationTokens EmailVerificationToken[]
  eventRatings       EventRating[]
  serverRequests     ServerRequest[]
  eventRequests      EventRequest[]
  ownedEvents        Event[]                  @relation("EventOwner")
  serverInterests    ServerInterest[]
  votes              Vote[]
  reportsMade        Report[]
  tickets            Ticket[]
}

// Single-use email-verification tokens. Only a SHA-256 hash of the token is
// stored; the raw token travels in the emailed link. Expired/used tokens are
// deleted. A user has at most one outstanding token (older ones are cleared on
// resend).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String // the address this token verifies (may differ from User.email if changed)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  discordUrl  String  @default("")
  events      Event[]
  interests   ServerInterest[]
}

model Event {
  id          String    @id @default(cuid())
  serverId    String
  name        String
  theme       String    @default("")
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ongoing") // upcoming | ongoing | concluded
  description String    @default("")
  discordUrl  String    @default("")
  // Ownership + host controls (F3). ownerId is set when a host's event request
  // is approved; SetNull keeps the event if the owner's account is removed.
  ownerId           String?
  commentsEnabled   Boolean @default(true)
  discussionEnabled Boolean @default(true)
  // Participation policy for this event's page. "verified" means taking part —
  // rating or commenting — requires a confirmed email address; "open" lets any
  // logged-in member join in. Submitting lore entries always needs a verified
  // email regardless, so a host can only relax their own page.
  ratingMode        String  @default("open") // open | verified
  // Whether the rating widget is offered at all, and whether the resulting
  // score is public. With ratingsPublic off, raters still see their own rating
  // but the average is the owner's and the archivists' to see.
  ratingsEnabled    Boolean @default(true)
  ratingsPublic     Boolean @default(true)
  ratingGuildId     String?
  ratingRoleId      String?
  // Host page personalization (F3/F7).
  bannerUrl    String?
  accentColor  String?
  customBlocks String  @default("[]")

  server  Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  owner   User?         @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  entries Entry[]
  ratings EventRating[]

  @@index([serverId])
}

model Entry {
  id           String   @id @default(cuid())
  eventId      String
  type         String // civilization | character | war | place | artifact
  layer        String // record | account
  name         String
  infobox      String   @default("{}") // JSON string of structured fields
  body         String   @default("") // markdown
  authorId     String
  attributedTo String? // faction/player a RP account is told by (account layer)
  status       String   @default("pending") // draft | pending | published
  disputed     Boolean  @default(false)
  // Feedback left by an archivist when sending an entry back for changes.
  // Surfaced to the author on their "My Contributions" page; cleared on resubmit.
  reviewFeedback   String?
  reviewFeedbackAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author    User       @relation("EntryAuthor", fields: [authorId], references: [id])
  evidence  Evidence[]
  revisions Revision[]

  @@index([eventId])
  @@index([status])
  @@index([type])
  @@index([layer])
}

model Evidence {
  id      String  @id @default(cuid())
  entryId String
  url     String
  caption String?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model Revision {
  id        String   @id @default(cuid())
  entryId   String
  body      String
  infobox   String
  note      String   @default("") // e.g. "created", "edited", "rolled back to <date>"
  editorId  String
  createdAt DateTime @default(now())

  entry  Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  editor User  @relation("RevisionEditor", fields: [editorId], references: [id])

  @@index([entryId])
}

// Durable record of moderation/review actions. Intentionally has NO foreign-key
// relations and stores denormalized snapshots (names), so the log survives even
// after the target entry/event/server or a user is deleted.
// Stars and comments attach to a SUBJECT (eventId + type + name), not a single
// entry, because a subject page is reachable through any of its entries' IDs.
// subjectKey is the same grouping key used throughout the app.
model Star {
  id         String   @id @default(cuid())
  subjectKey String
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectKey, userId])
  @@index([subjectKey])
}

model Comment {
  id         String   @id @default(cuid())
  subjectKey String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([subjectKey])
  @@index([createdAt])
}

// A member's rating of a (concluded/ongoing) event, on a 1–5 Minecraft-tier
// scale (copper → netherite). One rating per user per event; updating re-rates.
model EventRating {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  value     Int // 1..5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// Fixed-window rate-limit counters, keyed by action + IP (or user). Stored in
// the DB so limits are shared across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // approved | requested_changes | disputed | undisputed | rolled_back | deleted_entry | deleted_event | deleted_server | approved_server | approved_event | rejected_server | rejected_event
  actorId    String // who performed the action (archivist)
  actorName  String
  targetType String // entry | event | server | server_request | event_request
  targetId   String?
  targetName String
  authorName String? // original submitter (for entries / requests)
  reason     String? // e.g. the change-request message
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// A submission from an Event Host proposing a new server, pending archivist
// review. Approving it creates the real Server.
model ServerRequest {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  discordUrl      String
  status          String   @default("pending") // pending | approved | rejected
  reviewNote      String?
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdServerId String? // set once approved
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([requesterId])
}

// A submission proposing a new event (upcoming or concluded). It either attaches
// to an existing server (serverId) or proposes a new one (proposedServerName).
model EventRequest {
  id                 String    @id @default(cuid())
  serverId           String?
  proposedServerName String?
  name               String
  theme              String    @default("")
  startDate          DateTime
  endDate            DateTime?
  eventStatus        String    @default("upcoming") // upcoming | ongoing | concluded
  description        String    @default("")
  discordUrl         String
  status             String    @default("pending") // pending | approved | rejected
  reviewNote         String?
  requesterId        String
  requester          User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdEventId     String? // set once approved
  createdAt          DateTime  @default(now())

  @@index([status])
  @@index([requesterId])
}

// A user's standing interest in a server/host (F3). When that server publishes a
// new event, opted-in users get a Discord channel ping (delivered by the bot).
model ServerInterest {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
}

// Up/down vote on an account (lore version), a subject page, or a comment (F4).
// targetId is the entryId, subjectKey, or commentId depending on targetType.
model Vote {
  id         String   @id @default(cuid())
  userId     String
  targetType String // account | subject | comment
  targetId   String
  value      Int // +1 | -1
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// A user report against content or another user, for the moderation queue (F4).
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // entry | comment | user | event
  targetId   String
  reason     String
  details    String   @default("")
  status     String   @default("open") // open | resolved | dismissed
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

// A support/request ticket — initially used for requesting the event-host role (F4).
model Ticket {
  id         String   @id @default(cuid())
  userId     String
  type       String // event_host_request | other
  subject    String
  body       String   @default("")
  status     String   @default("open") // open | approved | rejected | closed
  reviewNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}
